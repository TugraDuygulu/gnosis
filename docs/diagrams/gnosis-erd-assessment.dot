digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.38", ranksep="0.65", splines=polyline, label="Gnosis v0.1 — relational ERD\nParent end: 1 required or 0..1 optional; child end: 0..*\nAll id columns are surrogate PKs; FK targets are id; ? means nullable.\nComposite UNIQUE / CHECK rules: see database_design.md", labelloc=t, fontsize=18, fontname="Helvetica"];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, color="#64748b", arrowsize=0.7];
CourseCurriculum [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>CourseCurriculum</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_coursecurriculum</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">course_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">version_number : PositiveIntegerField</TD></TR><TR><TD ALIGN="LEFT">status : CharField(20)</TD></TR></TABLE>>];
CourseOffering [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>CourseOffering</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_courseoffering</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">course_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">curriculum_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">instructor_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">po_framework_id ? : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">year : PositiveIntegerField</TD></TR><TR><TD ALIGN="LEFT">term : CharField(20)</TD></TR><TR><TD ALIGN="LEFT">section : CharField(10)</TD></TR><TR><TD ALIGN="LEFT">status : CharField(20)</TD></TR></TABLE>>];
LearningOutcome [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>LearningOutcome</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_learningoutcome</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">curriculum_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">code : CharField(20)</TD></TR><TR><TD ALIGN="LEFT">description : TextField</TD></TR></TABLE>>];
Enrollment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>Enrollment</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_enrollment</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">student_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">offering_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">status : CharField(20)</TD></TR></TABLE>>];
Assessment [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>Assessment</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_assessment</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">offering_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">name : CharField(100)</TD></TR><TR><TD ALIGN="LEFT">max_score : Decimal(7,2)</TD></TR><TR><TD ALIGN="LEFT">course_grade_weight : Decimal(5,2)</TD></TR></TABLE>>];
AssessmentLOMapping [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>AssessmentLOMapping</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_assessmentlomapping</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">assessment_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">learning_outcome_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">weight : Decimal(5,2)</TD></TR></TABLE>>];
Grade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>Grade</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_grade</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">enrollment_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">assessment_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">score ? : Decimal(7,2)</TD></TR></TABLE>>];
CourseCurriculum -> CourseOffering [dir=both, arrowtail=none, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2];
CourseCurriculum -> LearningOutcome [dir=both, arrowtail=none, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2];
CourseOffering -> Enrollment [dir=both, arrowtail=none, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2];
CourseOffering -> Assessment [dir=both, arrowtail=none, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2];
Assessment -> AssessmentLOMapping [dir=both, arrowtail=none, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2];
LearningOutcome -> AssessmentLOMapping [dir=both, arrowtail=none, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2];
Enrollment -> Grade [dir=both, arrowtail=none, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2];
Assessment -> Grade [dir=both, arrowtail=none, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2];
{rank=same; CourseCurriculum; CourseOffering;}
{rank=same; LearningOutcome; Enrollment; Assessment;}
{rank=same; AssessmentLOMapping; Grade;}
}
