Student [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>Student</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_student</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">program_id : ForeignKey FK</TD></TR><TR><TD ALIGN="LEFT">student_number : CharField(20) UK</TD></TR><TR><TD ALIGN="LEFT">full_name : CharField(200)</TD></TR></TABLE>>];
