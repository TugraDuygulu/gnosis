digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.38", ranksep="0.65", splines=polyline, label="Gnosis v0.1 — relational ERD\nParent end: 1 required or 0..1 optional; child end: 0..*\nAll id columns are surrogate PKs; FK targets are id; ? means nullable.\nComposite UNIQUE / CHECK rules: see database_design.md", labelloc=t, fontsize=18, fontname="Helvetica"];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, color="#64748b", arrowsize=0.7];
Program [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>Program</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_program</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">code : CharField(20) UK</TD></TR><TR><TD ALIGN="LEFT">name : CharField(200)</TD></TR></TABLE>>];
Course [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#17324d"><FONT COLOR="white"><B>Course</B></FONT></TD></TR><TR><TD BGCOLOR="#e2e8f0"><FONT POINT-SIZE="11">core_course</FONT></TD></TR><TR><TD ALIGN="LEFT">id : BigAutoField PK</TD></TR><TR><TD ALIGN="LEFT">code : CharField(20) UK</TD></TR><TR><TD ALIGN="LEFT">title : CharField(200)</TD></TR><TR><TD ALIGN="LEFT">credits : Decimal(4,1)</TD></TR></TABLE>>];
