erDiagram
    direction TB
    Program {
        BigAutoField id PK
        CharField_20 code UK
        CharField_200 name
    }
    Course {
        BigAutoField id PK
        CharField_20 code UK
        CharField_200 title
        Decimal_4_1 credits
    }
    Instructor {
        BigAutoField id PK
        CharField_200 full_name
        EmailField_254 email UK
    }
    Student {
        BigAutoField id PK
        ForeignKey program_id FK
        CharField_20 student_number UK
        CharField_200 full_name
    }
    POFramework {
        BigAutoField id PK
        ForeignKey program_id FK
        PositiveIntegerField version_number
        CharField_20 status
    }
    CourseCurriculum {
        BigAutoField id PK
        ForeignKey course_id FK
        PositiveIntegerField version_number
        CharField_20 status
    }
    ProgramOutcome {
        BigAutoField id PK
        ForeignKey framework_id FK
        CharField_20 code
        TextField description
    }
    CourseOffering {
        BigAutoField id PK
        ForeignKey course_id FK
        ForeignKey curriculum_id FK
        ForeignKey instructor_id FK
        ForeignKey po_framework_id FK "nullable"
        PositiveIntegerField year
        CharField_20 term
        CharField_10 section
        CharField_20 status
    }
    LearningOutcome {
        BigAutoField id PK
        ForeignKey curriculum_id FK
        CharField_20 code
        TextField description
    }
    Enrollment {
        BigAutoField id PK
        ForeignKey student_id FK
        ForeignKey offering_id FK
        CharField_20 status
    }
    Assessment {
        BigAutoField id PK
        ForeignKey offering_id FK
        CharField_100 name
        Decimal_7_2 max_score
        Decimal_5_2 course_grade_weight
    }
    LOPOMapping {
        BigAutoField id PK
        ForeignKey learning_outcome_id FK
        ForeignKey program_outcome_id FK
        PositiveSmallIntegerField strength
    }
    CoursePOContribution {
        BigAutoField id PK
        ForeignKey curriculum_id FK
        ForeignKey program_outcome_id FK
        PositiveSmallIntegerField weight
    }
    Grade {
        BigAutoField id PK
        ForeignKey enrollment_id FK
        ForeignKey assessment_id FK
        Decimal_7_2 score "nullable"
    }
    AssessmentLOMapping {
        BigAutoField id PK
        ForeignKey assessment_id FK
        ForeignKey learning_outcome_id FK
        Decimal_5_2 weight
    }
    Program ||--o{ Student : "program_id"
    Program ||--o{ POFramework : "program_id"
    Course ||--o{ CourseCurriculum : "course_id"
    POFramework ||--o{ ProgramOutcome : "framework_id"
    Course ||--o{ CourseOffering : "course_id"
    CourseCurriculum ||--o{ CourseOffering : "curriculum_id"
    Instructor ||--o{ CourseOffering : "instructor_id"
    POFramework |o--o{ CourseOffering : "po_framework_id"
    CourseCurriculum ||--o{ LearningOutcome : "curriculum_id"
    Student ||--o{ Enrollment : "student_id"
    CourseOffering ||--o{ Enrollment : "offering_id"
    CourseOffering ||--o{ Assessment : "offering_id"
    LearningOutcome ||--o{ LOPOMapping : "learning_outcome_id"
    ProgramOutcome ||--o{ LOPOMapping : "program_outcome_id"
    CourseCurriculum ||--o{ CoursePOContribution : "curriculum_id"
    ProgramOutcome ||--o{ CoursePOContribution : "program_outcome_id"
    Enrollment ||--o{ Grade : "enrollment_id"
    Assessment ||--o{ Grade : "assessment_id"
    Assessment ||--o{ AssessmentLOMapping : "assessment_id"
    LearningOutcome ||--o{ AssessmentLOMapping : "learning_outcome_id"
